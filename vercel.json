{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/client-portal",
      "destination": "https://jgm-client-portal.vercel.app/client-portal"
    },
    {
      "source": "/client-portal/:path*",
      "destination": "https://jgm-client-portal.vercel.app/client-portal/:path*"
    },
    {
      "source": "/api/portal/:path*",
      "destination": "https://jgm-client-portal.vercel.app/api/portal/:path*"
    },
    {
      "source": "/docs/:path*",
      "destination": "https://jgm-client-portal.vercel.app/docs/:path*"
    },
    {
      "source": "/logo.svg",
      "destination": "https://jgm-client-portal.vercel.app/logo.svg"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://jgm-client-portal.vercel.app/_next/:path*"
    }
  ],
  "headers": [
    {
      "source": "/updates/motion-dock/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/downloads/motion-dock/:path*",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/zip"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
