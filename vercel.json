{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/client-portal",
      "destination": "https://jgm-client-portal.vercel.app/client-portal"
    },
    {
      "source": "/client-portal/:path*",
      "destination": "https://jgm-client-portal.vercel.app/client-portal/:path*"
    },
    {
      "source": "/api/portal/:path*",
      "destination": "https://jgm-client-portal.vercel.app/api/portal/:path*"
    },
    {
      "source": "/docs/:path*",
      "destination": "https://jgm-client-portal.vercel.app/docs/:path*"
    },
    {
      "source": "/logo.svg",
      "destination": "https://jgm-client-portal.vercel.app/logo.svg"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://jgm-client-portal.vercel.app/_next/:path*"
    }
  ]
}
